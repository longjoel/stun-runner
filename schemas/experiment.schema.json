{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stun-runner.local/schemas/experiment.schema.json",
  "title": "Arcade experiment",
  "type": "object",
  "required": ["schema", "id", "start", "events", "expect"],
  "properties": {
    "schema": {"const": "arcade-experiment/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "start": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "port", "field", "action"],
        "properties": {
          "frame": {"type": "integer", "minimum": 0},
          "port": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1},
          "action": {"enum": ["press", "release", "set"]},
          "value": {"type": "integer"},
          "label": {"type": "string"}
        },
        "additionalProperties": false,
        "allOf": [
          {"if": {"properties": {"action": {"const": "set"}}}, "then": {"required": ["value"]}}
        ]
      }
    },
    "expect": {
      "type": "object",
      "oneOf": [
        {
          "required": ["kind", "frame"],
          "properties": {
            "kind": {"const": "frame"},
            "frame": {"type": "integer", "minimum": 0},
            "timeout_frames": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "required": ["kind", "terminal"],
          "properties": {
            "kind": {"const": "bounded_observation"},
            "terminal": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "instrumentation": {
      "type": "object",
      "required": ["tool"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "window": {"type": "string", "minLength": 1},
        "access": {"type": "string", "minLength": 1},
        "accesses": {"type": "array", "items": {"type": "string"}},
        "cpu": {"type": "string", "minLength": 1},
        "pcs": {"type": "array", "items": {"type": "string"}},
        "frames": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
