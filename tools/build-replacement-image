#!/usr/bin/env python3
"""Build a fixed-placement minimal replacement image manifest."""

import argparse
import hashlib
import json
import pathlib
import struct


FIXTURES = {
    "maincpu-68010": {"nop": ("4e71", 0xFF8000)},
    "gsp-tms34010": {"nop": ("0003", 0xFF800000)},
    # ADSP reset enters program word 4. Keep the reset-vector words present
    # and place the known NOP at the first executed word.
    "adsp2100": {
        "nop": ("0000000000000000000000000000000000000000", 0x0000),
        # MAME's 2100 executor encodes unconditional JUMP as the 0x18
        # opcode class, target in bits 4..17, and condition 0xf.
        "reset-loop": ("00000000000000000000000000000000" "0018004f", 0x0000),
        "init-prefix": (None, 0x0000),
        "init-state": (None, 0x0000),
    },
    "sound-6502": {"nop": ("ea", 0x1000)},
}


def adsp_init_prefix() -> bytes:
    """Encode the observed reset calls with source-defined return stubs."""
    words = [0] * (0x834 + 1)
    words[0x0004] = 0x001C780F  # CALL $0780, condition 0xf (always)
    words[0x0005] = 0x001C834F  # CALL $0834, condition 0xf (always)
    words[0x0006] = 0x0018006F  # JUMP $0006, condition 0xf (always)
    words[0x0780] = 0x000A000F  # RTS, condition 0xf (always)
    words[0x0834] = 0x000A000F  # RTS, condition 0xf (always)
    return b"".join(struct.pack(">I", word) for word in words)


def adsp_init_state() -> bytes:
    """Preserve the observed reset-side PM/DM setup through a bounded loop."""
    words = [0] * (0x846 + 1)
    words[0x0004] = 0x001C780F
    words[0x0005] = 0x001C834F
    observed = [
        0x00340008, 0x00340009, 0x0034000A, 0x0034000B,
        0x00380008, 0x00380009, 0x0038000A, 0x0038000B,
        0x00340015, 0x00380017, 0x0040000A, 0x0090030A,
        0x0091FE3A, 0x0081FFFA, 0x0023620F, 0x00180130,
        0x004FFFFA, 0x0091FFFA, 0x0034A000, 0x009401B0,
        0x003C0007, 0x0035FEF0, 0x00390190, 0x003C0065,
        0x0014020E, 0x006000A1, 0x005800A3, 0x0035FF50,
        0x00390000, 0x003C0095, 0x0014026E, 0x006000A1,
        0x005800A3, 0x0035FE90, 0x00390090, 0x003C0065,
        0x001402CE, 0x006000A1, 0x005800A3, 0x0081FFEA,
        0x0092007A, 0x004007CA, 0x0090029A, 0x0040001A,
        0x009001EA, 0x0040000A, 0x0092003A, 0x0092002A,
        0x009002BA, 0x009002AA, 0x0090108A, 0x0092002A,
        0x0090958A, 0x009002DA, 0x009002EA,
    ]
    for offset, word in enumerate(observed, start=0x0006):
        words[offset] = word
    words[0x003D] = 0x001C780F
    words[0x003E] = 0x001C834F
    words[0x003F] = 0x001803FF
    routine_0780 = [
        0x00380014, 0x00380035, 0x00340014, 0x00340037,
        0x00380008, 0x00340009, 0x004FFFF0, 0x0047FFF1,
        0x00412485, 0x004123C4, 0x0041236A, 0x00412422,
        0x00400003, 0x00480006, 0x00392360, 0x00580000,
        0x00580010, 0x00580050, 0x00580041, 0x00580000,
        0x00580010, 0x005800A0, 0x00580021, 0x00989550,
        0x00580030, 0x00580060, 0x00580040, 0x00580051,
        0x00580030, 0x00580060, 0x00580020, 0x005800A1,
        0x00989560, 0x000A000F,
    ]
    routine_0834 = [
        0x00340014, 0x00340087, 0x00340009, 0x00340008,
        0x00349590, 0x003495A1, 0x00AFFFF7, 0x00AFFFF7,
        0x00AFFFF7, 0x00AFFFF7, 0x00AFFFF7, 0x00AFFFF7,
        0x00A7FFF3, 0x00A7FFF3, 0x00A7FFF3, 0x00A7FFF3,
        0x00A7FFF3, 0x00A7FFF3, 0x000A000F,
    ]
    words[0x0780:0x0780 + len(routine_0780)] = routine_0780
    words[0x0834:0x0834 + len(routine_0834)] = routine_0834
    return b"".join(struct.pack(">I", word) for word in words)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--processor", choices=sorted(FIXTURES), required=True)
    parser.add_argument("--fixture", choices=("nop", "reset-loop", "init-prefix", "init-state"), default="nop")
    parser.add_argument("--origin", type=lambda value: int(value, 0))
    parser.add_argument("--entry", type=lambda value: int(value, 0))
    parser.add_argument("--output", type=pathlib.Path, required=True)
    args = parser.parse_args()

    if args.fixture not in FIXTURES[args.processor]:
        parser.error(f"fixture {args.fixture!r} is not available for {args.processor}")
    hex_bytes, default_origin = FIXTURES[args.processor][args.fixture]
    payload = (adsp_init_prefix() if args.fixture == "init-prefix" else
               adsp_init_state() if args.fixture == "init-state" else
               bytes.fromhex(hex_bytes))
    origin = default_origin if args.origin is None else args.origin
    entry = (origin + 4) if args.entry is None and args.processor == "adsp2100" else (origin if args.entry is None else args.entry)
    if origin < 0 or entry < origin or entry >= origin + len(payload):
        parser.error("entry must fall inside the emitted image")
    args.output.mkdir(parents=True, exist_ok=True)
    binary = args.output / f"{args.processor}.bin"
    binary.write_bytes(payload)
    image = {
        "schema": "stunrun-replacement-image/v1",
        "processor": args.processor,
        "fixture": args.fixture,
        "origin": f"0x{origin:X}",
        "entry": f"0x{entry:X}",
        "length": len(payload),
        "bytes_hex": payload.hex(),
        "sha256": hashlib.sha256(payload).hexdigest(),
        "binary": binary.name,
        "layout": "single fixed-origin section; no relocation",
    }
    (args.output / "image.json").write_text(json.dumps(image, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(image, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
