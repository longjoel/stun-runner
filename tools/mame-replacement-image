#!/usr/bin/env python3
"""Install and verify a replacement image in a bounded MAME run."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import subprocess
import tempfile


RESULT = re.compile(
    r"M2_REPLACEMENT_RESULT frame=(\d+) installed=(true|false) "
    r"first=([0-9A-Fa-f]+) entry_word=([0-9A-Fa-f]+) "
    r"mismatches=(\d+) final_pc=([0-9A-Fa-f]+)"
)


def lua_script(image: dict, payload: bytes, install_frame: int, settle: int) -> str:
    if image["processor"] != "adsp2100":
        raise ValueError("the first M2 runtime loader supports only adsp2100")
    if image["origin"] != "0x0":
        raise ValueError("ADSP runtime fixture must be placed at origin 0")
    if len(payload) % 4:
        raise ValueError("ADSP program image must be 32-bit word aligned")
    words = []
    for index in range(0, len(payload), 4):
        words.append(int.from_bytes(payload[index:index + 4], "big"))
    entry = int(image["entry"], 0)
    if entry < 0 or entry >= len(words):
        raise ValueError("ADSP entry must be a word index within the image")
    values = ",".join(f"0x{word:08X}" for word in words)
    return f'''local machine = manager.machine
local cpu = assert(machine.devices[':mainpcb:adsp'])
local maincpu = assert(machine.devices[':mainpcb:maincpu'])
local space = cpu.spaces['program']
local main_space = maincpu.spaces['program']
local words = {{{values}}}
local frame = 0
local installed = false
local first = 0
local entry_word = 0
local fetch_reads = 0
local readback_mismatches = 0
local install_frame = {install_frame}
local settle_frame = {install_frame + settle}

local function install()
    for index, word in ipairs(words) do
        -- The ADSP program address space is word-addressed. MAME's Lua
        -- address-space API exposes the mapped ADSP word index directly.
        space:write_u32(index - 1, word)
    end
    first = space:read_u32(0)
    entry_word = space:read_u32({entry})
    for index, word in ipairs(words) do
        if space:read_u32(index - 1) ~= word then
            readback_mismatches = readback_mismatches + 1
        end
    end
    -- Release the 68010-controlled ADSP reset, /BR, and /HALT lines so the
    -- replacement image is scheduled for execution after placement.
    main_space:write_u16(0x81801e, 0)
    main_space:write_u16(0x81801a, 0)
    main_space:write_u16(0x81801c, 0)
    cpu.state['PC'].value = {entry}
    installed = true
end

space:install_read_tap(0, 0x1fff, 'stunrun_replacement_fetch',
    function(offset, data, mask)
        if fetch_reads < 16 then
            print(string.format('M2_REPLACEMENT_FETCH pc=%04X addr=%04X data=%08X mask=%08X',
                cpu.state['PC'].value, offset, data, mask))
        end
        fetch_reads = fetch_reads + 1
    end)

if install_frame == 0 then
    -- Install before the first frame so the ADSP opcode cache cannot retain
    -- the original title-path image.
    install()
end

emu.register_frame_done(function()
    frame = frame + 1
    if install_frame > 0 and frame == install_frame then install() end
    if installed and frame <= settle_frame then
        print(string.format('M2_REPLACEMENT_PROGRESS frame=%d pc=%04X', frame, cpu.state['PC'].value))
    end
    if frame == settle_frame then
        print(string.format('M2_REPLACEMENT_RESULT frame=%d installed=%s first=%08X entry_word=%08X mismatches=%d final_pc=%04X',
            frame, tostring(installed), first, entry_word, readback_mismatches, cpu.state['PC'].value))
        machine:exit()
    end
end)
'''


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("image", type=pathlib.Path)
    parser.add_argument("--rompath", required=True, type=pathlib.Path)
    parser.add_argument("--output", required=True, type=pathlib.Path)
    parser.add_argument("--install-frame", type=int, default=140)
    parser.add_argument("--settle-frames", type=int, default=2)
    parser.add_argument("--mame", default="mame")
    args = parser.parse_args()
    if args.install_frame < 0 or args.settle_frames <= 0:
        parser.error("install frame must be nonnegative and settle frames positive")
    image = json.loads(args.image.read_text(encoding="utf-8"))
    binary = args.image.parent / image["binary"]
    payload = binary.read_bytes()
    if hashlib.sha256(payload).hexdigest() != image["sha256"]:
        raise SystemExit("replacement image hash does not match image.json")
    args.output.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="stunrun-replacement-") as temp:
        script = pathlib.Path(temp) / "replacement.lua"
        script.write_text(lua_script(image, payload, args.install_frame, args.settle_frames), encoding="utf-8")
        log = args.output / "mame.log"
        command = [
            args.mame, "-rompath", str(args.rompath), "stunrun", "-video", "none",
            "-sound", "none", "-skip_gameinfo", "-noreadconfig", "-nowriteconfig",
            "-cfg_directory", "/tmp/stunrun-mame-cfg", "-nonvram_save", "-seconds_to_run",
            str(max(3, (args.install_frame + args.settle_frames + 59) // 60 + 1)),
            "-autoboot_script", str(script),
        ]
        with log.open("w", encoding="utf-8") as handle:
            completed = subprocess.run(command, stdout=handle, stderr=subprocess.STDOUT,
                                       env={**os.environ, "SDL_VIDEODRIVER": "dummy"}, check=False)
    text = log.read_text(encoding="utf-8")
    matches = RESULT.findall(text)
    if completed.returncode or not matches:
        raise SystemExit(f"replacement image validation failed; see {log}")
    frame, installed, first, entry_word, mismatches, final_pc = matches[-1]
    result = {
        "schema": "stunrun-replacement-image-result/v1",
        "image": args.image.name,
        "image_sha256": image["sha256"],
        "processor": image["processor"],
        "entry": int(image["entry"], 0),
        "install_frame": args.install_frame,
        "settle_frames": args.settle_frames,
        "observed_frame": int(frame),
        "installed": installed == "true",
        "first_word": int(first, 16),
        "entry_word": int(entry_word, 16),
        "readback_mismatches": int(mismatches),
        "final_pc": int(final_pc, 16),
        "returncode": completed.returncode,
    }
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(result, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
