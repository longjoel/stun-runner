#!/usr/bin/env python3
"""Rank input-dependent RAM locations as annotation candidates.

This tool deliberately assigns no game semantics. It ranks locations that
differ between synchronized snapshot series and reports evidence for later
writer-PC and gameplay experiments.
"""

import argparse
import json
import pathlib


def load_series(directory: pathlib.Path) -> dict[int, dict]:
    snapshots = {}
    for path in sorted(directory.glob("snapshot-*.json")):
        value = json.loads(path.read_text(encoding="utf-8"))
        required = ("schema", "frame", "base", "count", "width", "values")
        if any(key not in value for key in required):
            raise SystemExit(f"{path}: not a memory snapshot")
        if value["schema"] != "stunrun-memory-snapshot/v1":
            raise SystemExit(f"{path}: unsupported schema {value['schema']!r}")
        if len(value["values"]) != value["count"]:
            raise SystemExit(f"{path}: value count does not match metadata")
        frame = int(value["frame"])
        if frame in snapshots:
            raise SystemExit(f"{directory}: duplicate frame {frame}")
        snapshots[frame] = value
    if not snapshots:
        raise SystemExit(f"{directory}: no snapshot-*.json files")
    first = next(iter(snapshots.values()))
    for value in snapshots.values():
        for key in ("base", "count", "width", "device", "space"):
            if value.get(key) != first.get(key):
                raise SystemExit(f"{directory}: incompatible snapshot field {key}")
    return snapshots


def rank(baseline: dict[int, dict], variant: dict[int, dict], top: int) -> list[dict]:
    frames = sorted(set(baseline) & set(variant))
    if not frames:
        raise SystemExit("baseline and variant have no common snapshot frames")
    first = baseline[frames[0]]
    candidates = []
    for offset in range(first["count"]):
        paired = [(frame, baseline[frame]["values"][offset], variant[frame]["values"][offset])
                  for frame in frames]
        diffs = [(frame, old, new) for frame, old, new in paired if old != new]
        if not diffs:
            continue
        first_diff = diffs[0][0]
        first_index = frames.index(first_diff)
        persistent = sum(1 for frame, old, new in paired
                         if frame >= first_diff and old != new)
        persistence = persistent / max(1, len(frames) - first_index)
        variant_values = [new for _, _, new in diffs]
        baseline_values = [old for _, old, _ in paired]
        # Search ordering only; this score is not a semantic classifier.
        score = persistence * 100.0 + (1.0 / (1 + first_index)) * 10.0
        candidates.append({
            "address": first["base"] + offset,
            "offset": offset,
            "first_diff_frame": first_diff,
            "last_diff_frame": diffs[-1][0],
            "differing_frames": len(diffs),
            "common_frames": len(frames),
            "persistence_after_first": round(persistence, 6),
            "baseline_unique_values": len(set(baseline_values)),
            "variant_unique_values": len(set(variant_values)),
            "first_change": {"before": diffs[0][1], "after": diffs[0][2]},
            "variant_values": variant_values[:16],
            "rank_score": round(score, 6),
            "claim": "INPUT-DEPENDENT-CANDIDATE; semantic ownership unresolved"
        })
    candidates.sort(key=lambda item: (-item["rank_score"], item["address"]))
    return candidates[:top]


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("baseline", type=pathlib.Path,
                        help="directory containing baseline snapshot-*.json files")
    parser.add_argument("variant", type=pathlib.Path,
                        help="directory containing perturbed-input snapshot-*.json files")
    parser.add_argument("-o", "--output", type=pathlib.Path)
    parser.add_argument("--top", type=int, default=100)
    args = parser.parse_args()
    if args.top <= 0:
        parser.error("--top must be positive")
    baseline, variant = load_series(args.baseline), load_series(args.variant)
    first = next(iter(baseline.values()))
    candidates = rank(baseline, variant, args.top)
    result = {
        "schema": "stunrun-memory-candidate-report/v1",
        "baseline": str(args.baseline),
        "variant": str(args.variant),
        "device": first.get("device"),
        "space": first.get("space"),
        "base": first["base"],
        "count": first["count"],
        "width": first["width"],
        "common_frames": sorted(set(baseline) & set(variant)),
        "candidate_count": len(candidates),
        "candidates": candidates,
        "interpretation": "Ranked RAM candidates require writer-PC attribution and controlled semantic experiments before annotation."
    }
    encoded = json.dumps(result, indent=2) + "\n"
    if args.output:
        args.output.write_text(encoded, encoding="utf-8")
    else:
        print(encoded, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
