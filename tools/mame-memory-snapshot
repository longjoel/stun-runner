#!/usr/bin/env python3
"""Capture raw bounded memory-space snapshots from pinned MAME."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import tempfile


MARKER = re.compile(r"MAME_MEMORY_SNAPSHOT frame=(\d+) path=(.+) nonzero=(\d+)")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--device", required=True)
    parser.add_argument("--space", default="program")
    parser.add_argument("--base", type=lambda value: int(value, 0), default=0)
    parser.add_argument("--count", type=lambda value: int(value, 0), required=True)
    parser.add_argument("--width", type=int, choices=(8, 16, 32), default=8)
    parser.add_argument("--address-stride", type=int, default=1,
                        help="address increment between sampled values")
    parser.add_argument("--frames", type=int, default=600)
    parser.add_argument("--targets", default=None)
    parser.add_argument("--input", choices=("none", "late", "late_drive", "weapon_probe", "collision_probe_left", "collision_probe_center", "collision_probe_hold_left", "collision_probe_hold_right", "damage_probe_sweep", "fork_lateral_sweep", "fork_button2_sweep", "fork_hold_left", "fork_hold_right", "fork_center", "fork_delayed_left", "fork_delayed_right", "course_sweep", "course_preface_left", "course_preface_right", "course_coin2", "service_probe", "sw1_all_on", "sw1_bit1", "sw1_bit2", "sw1_bit3", "sw1_bit4", "sw1_bit5", "sw1_bit6", "sw1_bit7", "sw1_bit8", "drive_hold"), default="none")
    parser.add_argument("--nothrottle", action="store_true", help="run MAME as fast as possible while preserving emulated frame numbers")
    parser.add_argument("--save-state", type=pathlib.Path, help="save a MAME state at the final requested frame")
    parser.add_argument("--load-state", type=pathlib.Path, help="load a MAME state before starting the relative frame counter")
    parser.add_argument("--playback", type=pathlib.Path,
                        help="replay a recorded .inp instead of scripted inputs")
    parser.add_argument("--mame", default="mame")
    args = parser.parse_args()
    if args.frames <= 0 or args.count <= 0 or args.base < 0 or args.address_stride <= 0:
        parser.error("frames, count, base, and address-stride must be positive/nonnegative")
    targets = args.targets or str(args.frames)
    if any(int(value) <= 0 or int(value) > args.frames for value in targets.split(',')):
        parser.error("targets must be positive frames no greater than --frames")
    args.output.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    state_stage = None
    state_directory = "/tmp/stunrun-state-dir"
    if args.load_state:
        if not args.load_state.is_file():
            raise SystemExit(f"save state does not exist: {args.load_state}")
        state_stage = pathlib.Path(tempfile.mkdtemp(prefix="stunrun-state-fork-"))
        slot_directory = state_stage / "stunrun"
        slot_directory.mkdir()
        shutil.copy2(args.load_state, slot_directory / "1.sta")
        state_directory = str(state_stage)
    if args.load_state and args.playback:
        parser.error("--load-state and --playback are mutually exclusive")
    playback = None
    if args.playback:
        if not args.playback.is_file():
            raise SystemExit(f"input recording does not exist: {args.playback}")
        playback = args.playback.resolve()
        if args.input != "none":
            parser.error("--playback requires --input none")
    config_args = ["-noreadconfig", "-nowriteconfig",
                   "-cfg_directory", "/tmp/stunrun-mame-cfg", "-nonvram_save"]
    playback_args = []
    if playback is not None:
        config_args = []
        playback_args = ["-input_directory", str(playback.parent),
                         "-playback", playback.name]
    command = [
        args.mame, "-rompath", str(args.rompath), "stunrun", "-video", "none",
        "-sound", "none", "-skip_gameinfo", *config_args,
        *playback_args,
        "-state_directory", state_directory, "-statename", "%g",
        "-seconds_to_run",
        str(86400 if args.load_state else max(2, (args.frames + 59) // 60 + 1)),
        "-autoboot_script",
        str(pathlib.Path(__file__).resolve().parents[1] / "mame/lua/memory-snapshot.lua"),
    ]
    if args.nothrottle:
        command.insert(command.index("-seconds_to_run"), "-nothrottle")
    if args.load_state:
        command.insert(command.index("-seconds_to_run"), "-state")
        command.insert(command.index("-seconds_to_run"), "1")
    environment = {
        **os.environ,
        "STUNRUN_MEMORY_DEVICE": args.device,
        "STUNRUN_MEMORY_SPACE": args.space,
        "STUNRUN_MEMORY_BASE": str(args.base),
        "STUNRUN_MEMORY_COUNT": str(args.count),
        "STUNRUN_MEMORY_WIDTH": str(args.width),
        "STUNRUN_MEMORY_STRIDE": str(args.address_stride),
        "STUNRUN_MEMORY_FRAMES": str(args.frames),
        "STUNRUN_MEMORY_TARGETS": targets,
        "STUNRUN_MEMORY_OUT": str(args.output),
        "STUNRUN_MEMORY_INPUT": args.input,
        "STUNRUN_MEMORY_PLAYBACK": str(playback) if playback else "",
        "STUNRUN_MEMORY_SAVE_STATE": str(args.save_state) if args.save_state else "",
        # Loading is performed by MAME's command-line state option.  Avoid
        # asking the Lua script to load the same state a second time.
        "STUNRUN_MEMORY_LOAD_STATE": "",
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "dummy"),
    }
    try:
        with log.open("w", encoding="utf-8") as handle:
            completed = subprocess.run(command, stdout=handle, stderr=subprocess.STDOUT,
                                       env=environment, check=False)
        text = log.read_text(encoding="utf-8")
    finally:
        if state_stage is not None:
            shutil.rmtree(state_stage, ignore_errors=True)
    matches = MARKER.findall(text)
    expected = [int(value) for value in targets.split(',')]
    snapshots = []
    # During state loading MAME can emit the same early frame more than once.
    # The Lua callback reuses that frame's path, so the later marker describes
    # the bytes that are actually left on disk.
    last_markers = {}
    for frame_text, path_text, nonzero_text in matches:
        last_markers[int(frame_text)] = (path_text, int(nonzero_text))
    for frame_number in expected:
        if frame_number not in last_markers:
            continue
        path_text, nonzero_number = last_markers[frame_number]
        path = pathlib.Path(path_text)
        if not path.is_file():
            raise SystemExit(f"MAME reported missing snapshot: {path}")
        payload = json.loads(path.read_text(encoding="utf-8"))
        payload["sha256"] = hashlib.sha256(path.read_bytes()).hexdigest()
        if payload["frame"] != frame_number or payload["nonzero"] != nonzero_number:
            raise SystemExit(f"snapshot marker mismatch: {path}")
        snapshots.append(payload)
    canonical = re.sub(r"path=.*? nonzero=", "path=<snapshot> nonzero=", text)
    result = {
        "schema": "stunrun-memory-snapshot-result/v1",
        "frames": args.frames,
        "targets": expected,
        "device": args.device,
        "space": args.space,
        "base": args.base,
        "count": args.count,
        "width": args.width,
        "address_stride": args.address_stride,
        "input": args.input,
        "playback": str(playback) if playback else None,
        "save_state": str(args.save_state) if args.save_state else None,
        "load_state": str(args.load_state) if args.load_state else None,
        "returncode": completed.returncode,
        "snapshots": [{"frame": item["frame"], "sha256": item["sha256"],
                       "nonzero": item["nonzero"]} for item in snapshots],
        "canonical_log_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
    }
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    if completed.returncode or [item["frame"] for item in snapshots] != list(dict.fromkeys(expected)):
        raise SystemExit(f"memory snapshot failed; see {log}")
    if args.save_state and not args.save_state.is_file():
        raise SystemExit(f"MAME did not produce save state: {args.save_state}")
    print(json.dumps(result, separators=(",", ":")))


if __name__ == "__main__":
    raise SystemExit(main())
