#!/usr/bin/env python3
"""Emit a compact, ROM-content-free manifest from MAME -listxml output."""

import argparse
import json
import pathlib
import sys
import xml.etree.ElementTree as ET


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("xml", type=pathlib.Path)
    parser.add_argument("--machine", default="stunrun")
    parser.add_argument("--mame-version", required=True)
    parser.add_argument("-o", "--output", type=pathlib.Path, required=True)
    args = parser.parse_args()

    root = ET.parse(args.xml).getroot()
    machine = next(
        (item for item in root.findall("machine") if item.get("name") == args.machine),
        None,
    )
    if machine is None:
        raise SystemExit(f"machine not found in XML: {args.machine}")

    roms = []
    for rom in machine.findall("rom"):
        entry = {
            "filename": rom.get("name"),
            "region": rom.get("region"),
            "size": int(rom.get("size", "0")),
            "crc32": rom.get("crc"),
            "sha1": rom.get("sha1"),
            "offset": int(rom.get("offset", "0"), 16),
        }
        for attribute in ("status", "optional", "merge"):
            if rom.get(attribute) is not None:
                entry[attribute] = rom.get(attribute)
        roms.append(entry)

    manifest = {
        "schema": "stunrun-rom-manifest/v1",
        "target": args.machine,
        "mame": {
            "version": args.mame_version,
            "listxml_machine": args.machine,
            "sourcefile": machine.get("sourcefile"),
        },
        "description": machine.findtext("description"),
        "parent": machine.get("cloneof"),
        "roms": roms,
    }

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    sys.exit(main())
