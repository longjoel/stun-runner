#!/usr/bin/env python3
"""Convert a MAME debugger disassembly trace into instruction LCOV."""

import argparse
import collections
import pathlib
import re


ADDRESS_RE = re.compile(r"^\s*([0-9a-fA-F]+):")


def addresses(path: pathlib.Path):
    result = {}
    for line_number, line in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        match = ADDRESS_RE.match(line)
        if match:
            result[int(match.group(1), 16)] = line_number
    return result


def hits(path: pathlib.Path):
    counts = collections.Counter()
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        match = ADDRESS_RE.match(line)
        if match:
            counts[int(match.group(1), 16)] += 1
    return counts


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("trace", type=pathlib.Path)
    parser.add_argument("listing", type=pathlib.Path)
    parser.add_argument("--source", required=True)
    parser.add_argument("--test-name", required=True)
    parser.add_argument("-o", "--output", type=pathlib.Path, required=True)
    args = parser.parse_args()

    line_by_address = addresses(args.listing)
    hit_by_address = hits(args.trace)
    line_hits = collections.Counter()
    for address, count in hit_by_address.items():
        if address in line_by_address:
            line_hits[line_by_address[address]] += count

    lines = [f"TN:{args.test_name}", f"SF:{args.source}"]
    for line_number in sorted(line_by_address.values()):
        lines.append(f"DA:{line_number},{line_hits[line_number]}")
    covered = sum(1 for line_number in line_by_address.values() if line_hits[line_number] > 0)
    lines.extend([f"LF:{len(line_by_address)}", f"LH:{covered}", "end_of_record", ""])
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text("\n".join(lines), encoding="utf-8")
    print(f"addresses={len(line_by_address)} hits={sum(hit_by_address.values())} covered={covered}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
