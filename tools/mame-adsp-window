#!/usr/bin/env python3
"""Capture bounded 68010 accesses to ADSP windows and the upload source range."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import subprocess


WRITE = re.compile(r"M1_ADSP_WRITE kind=([a-z_]+) pc=([0-9A-Fa-f]+) addr=([0-9A-Fa-f]+) data=([0-9A-Fa-f]+)")
READ = re.compile(
    r"M1_ADSP_READ kind=([a-z_]+) pc=([0-9A-Fa-f]+) addr=([0-9A-Fa-f]+) "
    r"data=([0-9A-Fa-f]+) mask=([0-9A-Fa-f]+)"
)
WINDOWS = {
    "program": ("0x800000", "0x8000", "0x800000-0x807fff"),
    "data": ("0x808000", "0x4000", "0x808000-0x80bfff"),
    "buffer": ("0x810000", "0x4000", "0x810000-0x813fff"),
    "source": ("0x17000", "0xf000", "0x17000-0x25fff"),
    "control": ("0x818000", "0x20", "0x818000-0x81801f"),
    "irq_clear": ("0x818060", "0x20", "0x818060-0x81807f"),
    "irq_state": ("0x838000", "0x8000", "0x838000-0x83ffff"),
}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frames", type=int, default=600)
    parser.add_argument("--window", choices=WINDOWS, default="program")
    parser.add_argument("--input", choices=("none", "coin_start", "sw_off_prestart"), default="none")
    parser.add_argument("--access", choices=("write", "read"), default="write")
    parser.add_argument("--mame", default="mame")
    args = parser.parse_args()
    if args.frames <= 0:
        parser.error("--frames must be positive")
    args.output.mkdir(parents=True, exist_ok=True)
    base, length, address_range = WINDOWS[args.window]
    log = args.output / "mame.log"
    command = [
        args.mame, "-rompath", str(args.rompath), "stunrun",
        "-video", "none", "-sound", "none", "-skip_gameinfo",
        "-noreadconfig", "-nowriteconfig", "-cfg_directory", "/tmp/stunrun-mame-cfg",
        "-nonvram_save", "-debug", "-debugger", "none",
        "-seconds_to_run", str(max(2, (args.frames + 59) // 60 + 1)),
        "-autoboot_script", str(pathlib.Path(__file__).resolve().parents[1] / "mame/lua/adsp-window.lua"),
    ]
    environment = {
        "STUNRUN_ADSP_WINDOW_OUT": str(args.output),
        "STUNRUN_ADSP_WINDOW_FRAMES": str(args.frames),
        "STUNRUN_ADSP_WINDOW_BASE": base,
        "STUNRUN_ADSP_WINDOW_LENGTH": length,
        "STUNRUN_ADSP_WINDOW_LABEL": args.window,
        "STUNRUN_ADSP_WINDOW_INPUT": args.input,
        "STUNRUN_ADSP_WINDOW_ACCESS": args.access,
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "dummy"),
    }
    with log.open("w", encoding="utf-8") as handle:
        completed = subprocess.run(command, stdout=handle, stderr=subprocess.STDOUT, env={**os.environ, **environment}, check=False)
    text = log.read_text(encoding="utf-8")
    writes = [
        {"kind": match.group(1), "pc": int(match.group(2), 16), "address": int(match.group(3), 16), "data": int(match.group(4), 16)}
        for match in WRITE.finditer(text)
    ]
    reads = [
        {"kind": match.group(1), "pc": int(match.group(2), 16), "address": int(match.group(3), 16),
         "data": int(match.group(4), 16), "mask": int(match.group(5), 16)}
        for match in READ.finditer(text)
    ]
    observations = writes if args.access == "write" else reads
    canonical_log = re.sub(r"output=[^\n]+", "output=<output>", text)
    result = {
        "schema": "stunrun-adsp-window-result/v1",
        "experiment": f"adsp_{args.window}_window",
        "window": address_range,
        "frames": args.frames,
        "input": args.input,
        "access": args.access,
        "returncode": completed.returncode,
        "observations": len(observations),
        "distinct_pcs": sorted({item["pc"] for item in observations}),
        "address_min": min((item["address"] for item in observations), default=None),
        "address_max": max((item["address"] for item in observations), default=None),
        "first_observations": observations[:16],
        "last_observations": observations[-16:],
        "canonical_log_sha256": hashlib.sha256(canonical_log.encode("utf-8")).hexdigest(),
    }
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    if completed.returncode:
        raise SystemExit(f"MAME failed; see {log}")
    print(json.dumps(result, separators=(",", ":")))


if __name__ == "__main__":
    main()
