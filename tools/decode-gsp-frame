#!/usr/bin/env python3
"""Decode one captured STUN Runner multisync GSP frame.

This follows the installed MAME harddriv multisync scanline callback literally.
The palette snapshots are reads through MAME's banked palette handler, so their
first 256 words are the currently selected palette bank.
"""

import argparse
import json
import pathlib


def load(path):
    value = json.loads(path.read_text(encoding="utf-8"))
    if value.get("schema") != "stunrun-memory-snapshot/v1":
        raise SystemExit(f"{path}: expected a memory snapshot")
    return value


def display_from(path, frame):
    value = json.loads(path.read_text(encoding="utf-8"))
    if value.get("schema") != "stunrun-gsp-state-snapshot-result/v1":
        raise SystemExit(f"{path}: expected a GSP state result")
    matches = [item for item in value.get("snapshots", []) if item["frame"] == frame]
    if len(matches) != 1 or "display" not in matches[0]:
        raise SystemExit(f"{path}: frame {frame} has no display-register sample")
    return matches[0]["display"]


def palette(lo, hi):
    if len(lo["values"]) < 256 or len(hi["values"]) < 256:
        raise SystemExit("palette snapshots must contain at least 256 words")
    return [
        ((lo["values"][index] >> 8) & 0xff,
         lo["values"][index] & 0xff,
         hi["values"][index] & 0xff)
        for index in range(256)
    ]


def decode(args):
    vram = load(args.vram)["values"]
    lo = load(args.palette_lo)
    hi = load(args.palette_hi)
    display = display_from(args.state_result, args.frame)
    width = args.width
    height = args.lines
    colors = palette(lo, hi)
    dpy_start = (args.start_dpyadr if args.start_dpyadr is not None
                 else display["dpystart"]) & 0xffff
    dpy_step = (args.dpy_step if args.dpy_step is not None
                else -(display["dpyctl"] & 0x03fc))
    dpy_tap = args.dpy_tap if args.dpy_tap is not None else 0
    fine = args.fine_scroll if args.fine_scroll is not None else 0
    pixel_data = bytearray(width * height * 3)
    mask = len(vram) - 1
    if len(vram) == 0 or len(vram) & mask:
        raise SystemExit("VRAM word count must be a power of two")
    heblnk = max(0, display["heblnk"] * 2)
    hsblnk = display["hsblnk"] * 2
    for y in range(height):
        dpyadr = (dpy_start + y * dpy_step) & 0xffff
        if display["dpyctl"] & 0x0400:
            rowaddr = dpyadr >> 4
        else:
            rowaddr = (dpyadr ^ 0xfffc) >> 4
        coladdr = ((dpyadr & 0x007c) << 4) | (dpy_tap & 0x3fff)
        yoffset = (dpy_start - dpyadr) & 3
        color_index = ((yoffset << 9) + ((coladdr & 0xff) << 3)
                       - 7 + (fine & 7))
        row_base = (rowaddr << 10) & mask
        for output_x in range(width):
            x = heblnk + output_x
            if x >= hsblnk:
                break
            index = (color_index + x) & 0x7ff
            word = vram[(row_base + (index >> 1)) & mask]
            color = (word >> 8) & 0xff if index & 1 else word & 0xff
            r, g, b = colors[color]
            offset = (y * width + output_x) * 3
            pixel_data[offset:offset + 3] = bytes((r, g, b))
    args.output.write_bytes(
        b"P6\n" + f"{width} {height}\n255\n".encode("ascii") + pixel_data
    )
    return {
        "schema": "stunrun-gsp-frame-decode/v1",
        "frame": args.frame,
        "width": width,
        "height": height,
        "start_dpyadr": dpy_start,
        "dpy_step": dpy_step,
        "dpy_tap": dpy_tap,
        "fine_scroll": fine & 7,
        "heblnk_pixels": heblnk,
        "hsblnk_pixels": hsblnk,
        "output": str(args.output),
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("vram", type=pathlib.Path)
    parser.add_argument("palette_lo", type=pathlib.Path)
    parser.add_argument("palette_hi", type=pathlib.Path)
    parser.add_argument("state_result", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frame", type=int, required=True)
    parser.add_argument("--width", type=int, default=512)
    parser.add_argument("--lines", type=int, default=240)
    parser.add_argument("--start-dpyadr", type=lambda value: int(value, 0))
    parser.add_argument("--dpy-step", type=lambda value: int(value, 0))
    parser.add_argument("--dpy-tap", type=lambda value: int(value, 0))
    parser.add_argument("--fine-scroll", type=lambda value: int(value, 0))
    args = parser.parse_args()
    if args.width <= 0 or args.lines <= 0:
        parser.error("width and lines must be positive")
    args.output.parent.mkdir(parents=True, exist_ok=True)
    print(json.dumps(decode(args), sort_keys=True))


if __name__ == "__main__":
    main()
