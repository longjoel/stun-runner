#!/usr/bin/env python3
"""Find temporally structured RAM values in a synchronized snapshot series.

Values are decoded big-endian because the target main CPU is a 68010. Results
are hypotheses only: monotonicity can describe a timer, counter, animation,
or renderer state and requires writer/event evidence before naming.
"""

import argparse
import json
import pathlib


def load_series(directory: pathlib.Path) -> list[dict]:
    paths = sorted(directory.glob("snapshot-*.json"))
    if not paths:
        raise SystemExit(f"{directory}: no snapshot-*.json files")
    values = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
    first = values[0]
    required = ("schema", "frame", "base", "count", "width", "values")
    if any(key not in first for key in required):
        raise SystemExit(f"{paths[0]}: not a memory snapshot")
    for value in values:
        if value.get("schema") != "stunrun-memory-snapshot/v1":
            raise SystemExit(f"{directory}: unsupported snapshot schema")
        for key in ("base", "count", "width", "device", "space"):
            if value.get(key) != first.get(key):
                raise SystemExit(f"{directory}: incompatible snapshot field {key}")
        if len(value["values"]) != value["count"]:
            raise SystemExit(f"{directory}: value count does not match metadata")
    return sorted(values, key=lambda item: item["frame"])


def decode(values: list[int], offset: int, width: int) -> int:
    result = 0
    for value in values[offset:offset + width]:
        result = (result << 8) | value
    return result


def rank(series: list[dict], top: int, min_changes: int) -> list[dict]:
    first = series[0]
    candidates = []
    for width in (1, 2, 4):
        for offset in range(0, first["count"] - width + 1, width):
            sequence = [decode(snapshot["values"], offset, width) for snapshot in series]
            changes = [index for index in range(1, len(sequence))
                       if sequence[index] != sequence[index - 1]]
            if len(changes) < min_changes:
                continue
            deltas = [sequence[index] - sequence[index - 1] for index in changes]
            direction = 1 if sum(delta > 0 for delta in deltas) >= sum(delta < 0 for delta in deltas) else -1
            directional = sum((delta > 0 if direction == 1 else delta < 0) for delta in deltas)
            monotonicity = directional / len(deltas)
            candidates.append({
                "address": first["base"] + offset,
                "address_hex": f"0x{first['base'] + offset:X}",
                "width_bytes": width,
                "frames": [snapshot["frame"] for snapshot in series],
                "values": sequence,
                "changed_frames": [series[index]["frame"] for index in changes],
                "changed_count": len(changes),
                "direction": "increasing" if direction == 1 else "decreasing",
                "monotonicity": round(monotonicity, 6),
                "value_range": max(sequence) - min(sequence),
                "claim": "TEMPORALLY-STRUCTURED-CANDIDATE; semantics and ownership unresolved"
            })
    candidates.sort(key=lambda item: (-item["monotonicity"], -item["changed_count"],
                                      -item["value_range"], item["address"], item["width_bytes"]))
    return candidates[:top]


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("snapshots", type=pathlib.Path)
    parser.add_argument("-o", "--output", type=pathlib.Path)
    parser.add_argument("--top", type=int, default=100)
    parser.add_argument("--min-changes", type=int, default=2)
    args = parser.parse_args()
    if args.top <= 0 or args.min_changes <= 0:
        parser.error("--top and --min-changes must be positive")
    series = load_series(args.snapshots)
    first = series[0]
    candidates = rank(series, args.top, args.min_changes)
    result = {
        "schema": "stunrun-memory-series-report/v1",
        "snapshots": str(args.snapshots),
        "device": first.get("device"), "space": first.get("space"),
        "base": first["base"], "count": first["count"], "width": first["width"],
        "frames": [snapshot["frame"] for snapshot in series],
        "candidate_count": len(candidates), "candidates": candidates,
        "interpretation": "Temporal candidates require controlled event correlation and writer-PC attribution before semantic annotation."
    }
    encoded = json.dumps(result, indent=2) + "\n"
    if args.output:
        args.output.write_text(encoded, encoding="utf-8")
    else:
        print(encoded, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
