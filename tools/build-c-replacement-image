#!/usr/bin/env python3
"""Build an ADSP replacement manifest from the shared C image emitter."""

import argparse
import hashlib
import json
import pathlib
import subprocess


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--emitter", type=pathlib.Path, required=True)
    parser.add_argument("--fixture", choices=("nop", "reset-loop", "init-prefix", "init-state"), required=True)
    parser.add_argument("--output", type=pathlib.Path, required=True)
    args = parser.parse_args()
    args.output.mkdir(parents=True, exist_ok=True)
    binary = args.output / "adsp2100.bin"
    completed = subprocess.run(
        [str(args.emitter), args.fixture, str(binary)],
        capture_output=True, text=True, check=False)
    if completed.returncode:
        raise SystemExit(completed.stderr or "C ADSP image emitter failed")
    payload = binary.read_bytes()
    if len(payload) % 4:
        raise SystemExit("C ADSP image emitter produced an unaligned image")
    image = {
        "schema": "stunrun-replacement-image/v1",
        "processor": "adsp2100",
        "fixture": args.fixture,
        "origin": "0x0",
        "entry": "0x4",
        "length": len(payload),
        "bytes_hex": payload.hex(),
        "sha256": hashlib.sha256(payload).hexdigest(),
        "binary": binary.name,
        "layout": "single fixed-origin section; no relocation",
        "emitter": "reproduction/adsp/adsp_image_dump.c",
    }
    (args.output / "image.json").write_text(
        json.dumps(image, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(image, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
