#!/usr/bin/env python3
"""Compare two binary P6 RGB frames and emit a compact JSON report."""

import argparse
import hashlib
import json
import pathlib


def read_ppm(path):
    data = pathlib.Path(path).read_bytes()
    if not data.startswith(b"P6"):
        raise ValueError(f"{path}: expected P6 PPM")
    pos = 0
    tokens = []
    while len(tokens) < 4:
        while pos < len(data) and data[pos] in b" \t\r\n":
            pos += 1
        if pos < len(data) and data[pos] == ord('#'):
            end = data.find(b'\n', pos)
            if end < 0:
                raise ValueError(f"{path}: unterminated comment")
            pos = end + 1
            continue
        end = pos
        while end < len(data) and data[end] not in b" \t\r\n":
            end += 1
        if end == pos:
            raise ValueError(f"{path}: truncated header")
        tokens.append(data[pos:end])
        pos = end
    if tokens[0] != b"P6":
        raise ValueError(f"{path}: expected P6 PPM")
    try:
        width, height, maximum = (int(token) for token in tokens[1:])
    except ValueError as exc:
        raise ValueError(f"{path}: invalid PPM header") from exc
    if width <= 0 or height <= 0 or maximum != 255:
        raise ValueError(f"{path}: only positive 8-bit PPMs are supported")
    while pos < len(data) and data[pos] in b" \t\r\n":
        pos += 1
    payload = data[pos:]
    expected = width * height * 3
    if len(payload) != expected:
        raise ValueError(f"{path}: expected {expected} RGB bytes, got {len(payload)}")
    return width, height, payload, hashlib.sha256(data).hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("expected", type=pathlib.Path)
    parser.add_argument("actual", type=pathlib.Path)
    args = parser.parse_args()
    ew, eh, expected, expected_sha = read_ppm(args.expected)
    aw, ah, actual, actual_sha = read_ppm(args.actual)
    report = {
        "schema": "stunrun-ppm-comparison/v1",
        "expected": {"path": str(args.expected), "sha256": expected_sha,
                      "width": ew, "height": eh},
        "actual": {"path": str(args.actual), "sha256": actual_sha,
                    "width": aw, "height": ah},
        "equal": False,
        "changed_pixels": None,
        "changed_channels": None,
        "max_abs_error": None,
        "mean_abs_error": None,
    }
    if (ew, eh) != (aw, ah):
        report["error"] = "dimension mismatch"
        print(json.dumps(report, sort_keys=True))
        return 1
    changed_pixels = changed_channels = max_error = total_error = 0
    for offset in range(0, len(expected), 3):
        pixel_changed = False
        for index in range(3):
            error = abs(expected[offset + index] - actual[offset + index])
            if error:
                pixel_changed = True
                changed_channels += 1
                total_error += error
                max_error = max(max_error, error)
        if pixel_changed:
            changed_pixels += 1
    report.update({
        "equal": expected == actual,
        "changed_pixels": changed_pixels,
        "changed_channels": changed_channels,
        "max_abs_error": max_error,
        "mean_abs_error": total_error / len(expected) if expected else 0.0,
    })
    print(json.dumps(report, sort_keys=True))
    return 0 if report["equal"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
