#!/usr/bin/env python3
"""Capture deterministic ADSP program-RAM landmarks from MAME."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import tempfile


SNAPSHOT = re.compile(
    r"M1_ADSP_PROGRAM_SNAPSHOT frame=(\d+) pc=([0-9A-F]+) mstat=([0-9A-F]+) nonzero=(\d+) first=([0-9A-F,]+)"
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frames", type=int, default=600)
    parser.add_argument("--targets", default="1,10,122,136,600")
    parser.add_argument("--mame", default="mame")
    parser.add_argument("--load-state", type=pathlib.Path,
                        help="load a MAME state before starting the relative frame counter")
    parser.add_argument("--nothrottle", action="store_true",
                        help="run MAME as fast as possible while preserving emulated frame numbers")
    args = parser.parse_args()
    if args.frames <= 0:
        parser.error("--frames must be positive")
    args.output.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    state_stage = None
    state_directory = "/tmp/stunrun-state-dir"
    if args.load_state:
        if not args.load_state.is_file():
            raise SystemExit(f"save state does not exist: {args.load_state}")
        state_stage = pathlib.Path(tempfile.mkdtemp(prefix="stunrun-adsp-state-fork-"))
        slot_directory = state_stage / "stunrun"
        slot_directory.mkdir()
        shutil.copy2(args.load_state, slot_directory / "1.sta")
        state_directory = str(state_stage)
    command = [
        args.mame, "-rompath", str(args.rompath), "stunrun", "-video", "none",
        "-sound", "none", "-skip_gameinfo", "-noreadconfig", "-nowriteconfig",
        "-cfg_directory", "/tmp/stunrun-mame-cfg", "-nonvram_save",
        "-state_directory", state_directory, "-statename", "%g", "-debug",
        "-debugger", "none", "-seconds_to_run",
        str(86400 if args.load_state else max(2, (args.frames + 59) // 60 + 1)),
        "-autoboot_script", str(pathlib.Path(__file__).resolve().parents[1] / "mame/lua/adsp-program-snapshot.lua"),
    ]
    if args.load_state:
        command.insert(command.index("-seconds_to_run"), "-state")
        command.insert(command.index("-seconds_to_run"), "1")
    if args.nothrottle:
        command.insert(command.index("-seconds_to_run"), "-nothrottle")
    environment = {
        "STUNRUN_ADSP_SNAPSHOT_FRAMES": str(args.frames),
        "STUNRUN_ADSP_SNAPSHOT_TARGETS": args.targets,
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "dummy"),
    }
    try:
        with log.open("w", encoding="utf-8") as handle:
            completed = subprocess.run(
                command, stdout=handle, stderr=subprocess.STDOUT,
                env={**os.environ, **environment}, check=False,
            )
        text = log.read_text(encoding="utf-8")
    finally:
        if state_stage is not None:
            shutil.rmtree(state_stage, ignore_errors=True)
    snapshots = [
        {"frame": int(match.group(1)), "pc": int(match.group(2), 16),
         "mstat": int(match.group(3), 16), "nonzero_words": int(match.group(4)),
         "first_words": [int(value, 16) for value in match.group(5).split(",")]}
        for match in SNAPSHOT.finditer(text)
    ]
    canonical = re.sub(r"M1_ADSP_PROGRAM_SNAPSHOT_DONE frames=\d+", "M1_ADSP_PROGRAM_SNAPSHOT_DONE frames=<frames>", text)
    result = {
        "schema": "stunrun-adsp-program-snapshot-result/v1",
        "frames": args.frames,
        "targets": args.targets,
        "load_state": str(args.load_state) if args.load_state else None,
        "nothrottle": args.nothrottle,
        "returncode": completed.returncode,
        "snapshots": snapshots,
        "canonical_log_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
    }
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    if completed.returncode:
        raise SystemExit(f"MAME failed; see {log}")
    print(json.dumps(result, separators=(",", ":")))


if __name__ == "__main__":
    main()
