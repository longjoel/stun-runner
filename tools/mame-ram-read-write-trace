#!/usr/bin/env python3
"""Capture bounded reads and writes in one MAME invocation."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys


READ = re.compile(
    r"M1_RAM_READ frame=(\d+) pc=([0-9A-Fa-f]+) addr=([0-9A-Fa-f]+) "
    r"data=([0-9A-Fa-f]+) mask=([0-9A-Fa-f]+)"
    r"(?: a0=([0-9A-Fa-f]+) a1=([0-9A-Fa-f]+) a5=([0-9A-Fa-f]+)"
    r" a10=([0-9A-Fa-f]+) a11=([0-9A-Fa-f]+))?"
    r"(?: order=(\d+))?"
)
READ_DONE = re.compile(
    r"M1_RAM_READ_DONE frames=(\d+) events=(\d+) truncated=(true|false)"
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--device", default=":mainpcb:maincpu")
    parser.add_argument("--space", default="program")
    parser.add_argument("--write-base", type=lambda x: int(x, 0), required=True)
    parser.add_argument("--write-end", type=lambda x: int(x, 0), required=True)
    parser.add_argument("--read-base", type=lambda x: int(x, 0), required=True)
    parser.add_argument("--read-end", type=lambda x: int(x, 0), required=True)
    parser.add_argument("--frames", type=int, default=60)
    parser.add_argument("--start-frame", type=int, default=1)
    parser.add_argument("--end-frame", type=int, default=60)
    parser.add_argument("--max-events", type=int, default=50000)
    parser.add_argument("--read-max-events", type=int, default=50000)
    parser.add_argument("--pc", type=lambda x: int(x, 0))
    parser.add_argument("--read-pc", action="append", type=lambda x: int(x, 0),
                        help="capture reads only at this PC; may be repeated")
    parser.add_argument("--registers", action="store_true")
    parser.add_argument("--order", action="store_true",
                        help="include shared same-run read/write event order")
    parser.add_argument("--tap-frame", type=int, default=10)
    parser.add_argument("--input", default="none")
    parser.add_argument("--load-state", type=pathlib.Path)
    parser.add_argument("--nothrottle", action="store_true")
    args = parser.parse_args()
    if args.load_state and not args.load_state.is_file():
        parser.error(f"save state does not exist: {args.load_state}")
    write_tool = pathlib.Path(__file__).with_name("mame-ram-write-trace")
    command = [str(write_tool), str(args.rompath), str(args.output),
               "--device", args.device, "--space", args.space,
               "--base", hex(args.write_base), "--end", hex(args.write_end),
               "--frames", str(args.frames), "--start-frame", str(args.start_frame),
               "--end-frame", str(args.end_frame), "--max-events", str(args.max_events),
               "--tap-frame", str(args.tap_frame), "--input", args.input]
    if args.order:
        command.append("--order")
    if args.pc is not None:
        command += ["--pc", hex(args.pc)]
    if args.registers:
        command.append("--registers")
    if args.load_state:
        command += ["--load-state", str(args.load_state)]
    if args.nothrottle:
        command.append("--nothrottle")
    env = dict(os.environ)
    env.update({
        "STUNRUN_RAM_READ_BASE": str(args.read_base),
        "STUNRUN_RAM_READ_END": str(args.read_end),
        "STUNRUN_RAM_READ_MAX_EVENTS": str(args.read_max_events),
        "STUNRUN_RAM_READ_PC": ",".join(str(pc) for pc in (args.read_pc or [])),
    })
    completed = subprocess.run(command, env=env, check=False)
    result_path = args.output / "result.json"
    if not result_path.is_file():
        return completed.returncode or 1
    write_result = json.loads(result_path.read_text(encoding="utf-8"))
    log_path = args.output / "mame.log"
    log_text = log_path.read_text(encoding="utf-8") if log_path.is_file() else ""
    reads = []
    for match in READ.finditer(log_text):
        event = {"frame": int(match.group(1)), "pc": int(match.group(2), 16),
                 "address": int(match.group(3), 16), "data": int(match.group(4), 16),
                 "mask": int(match.group(5), 16)}
        if match.group(6) is not None:
            event.update({"a0": int(match.group(6), 16), "a1": int(match.group(7), 16),
                          "a5": int(match.group(8), 16), "a10": int(match.group(9), 16),
                          "a11": int(match.group(10), 16)})
        if match.group(11) is not None:
            event["order"] = int(match.group(11))
        reads.append(event)
    done = READ_DONE.findall(log_text)
    result = {
        "schema": "stunrun-ram-read-write-trace-result/v1",
        "write": write_result,
        "read": {"schema": "stunrun-ram-read-trace-result/v1",
                  "device": args.device, "space": args.space,
                  "base": args.read_base, "end": args.read_end,
                  "frames": args.frames, "capture_start_frame": args.start_frame,
                  "capture_end_frame": args.end_frame, "pc": args.read_pc,
                  "registers": args.registers, "events": reads,
                  "event_count": len(reads),
                  "reader_pcs": sorted({event["pc"] for event in reads}),
                  "canonical_log_sha256": hashlib.sha256(log_text.encode()).hexdigest(),
                  "truncated": bool(done and done[-1][2] == "true")},
    }
    result_path.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    if completed.returncode or not done:
        return completed.returncode or 1
    print(json.dumps({"schema": result["schema"], "write_events": write_result["event_count"],
                      "read_events": len(reads), "read_truncated": result["read"]["truncated"]}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
