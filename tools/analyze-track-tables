#!/usr/bin/env python3
"""Summarize S.T.U.N. Runner ROM track-table slots without dumping ROM bytes."""

import argparse
import hashlib
import json
import pathlib


DEFAULT_BASES = (0x44630, 0x44930, 0x44C30, 0x44F30, 0x45230, 0x45530)
TABLE_BYTES = 0x300
RAM_BASE = 0xFF9584
STATE_TABLE_BASE = 0x47406
STATE_TABLE_COUNT = 23


def contiguous_ranges(indices: list[int]) -> list[str]:
    if not indices:
        return []
    ranges = []
    start = previous = indices[0]
    for value in indices[1:]:
        if value != previous + 1:
            ranges.append(f"{start}-{previous}")
            start = value
        previous = value
    ranges.append(f"{start}-{previous}")
    return ranges


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path,
                        help="directory containing the validated stunrun ROM set")
    parser.add_argument("--manifest", type=pathlib.Path,
                        default=pathlib.Path("roms/stunrun.manifest.json"))
    parser.add_argument("--base", action="append", type=lambda value: int(value, 0),
                        help="384-word table base; repeatable (defaults to all six selector targets)")
    parser.add_argument("--output", type=pathlib.Path,
                        help="write the summary JSON here instead of stdout")
    parser.add_argument("--snapshot", action="append", type=pathlib.Path,
                        help="compare a v1 main-CPU RAM snapshot; repeatable")
    args = parser.parse_args()

    manifest = json.loads(args.manifest.read_text(encoding="utf-8"))
    bases = args.base or list(DEFAULT_BASES)
    files = [item for item in manifest["roms"] if item["region"] == "mainpcb:maincpu"]
    if not files:
        raise SystemExit("manifest has no mainpcb:maincpu ROM files")
    region_size = max(item["offset"] + 2 * item["size"] for item in files)
    region = bytearray(region_size)
    occupied = bytearray(region_size)
    rom_root = args.rompath / "stunrun"
    for item in files:
        data = (rom_root / item["filename"]).read_bytes()
        if len(data) != item["size"]:
            raise SystemExit(f"size mismatch for {item['filename']}")
        offset = item["offset"]
        for index, value in enumerate(data):
            address = offset + 2 * index
            if occupied[address]:
                raise SystemExit(f"overlapping main CPU ROM placement at 0x{address:X}")
            region[address] = value
            occupied[address] = 1

    table_payloads = {}
    tables = {}
    for base in bases:
        end = base + TABLE_BYTES
        if end > len(region) or not all(occupied[base:end]):
            raise SystemExit(f"table range 0x{base:X}-0x{end - 1:X} is not fully mapped")
        payload = bytes(region[base:end])
        table_payloads[base] = payload
        tables[base] = [int.from_bytes(payload[index:index + 2], "big")
                        for index in range(0, TABLE_BYTES, 2)]

    first = tables[bases[0]]
    common = [index for index in range(len(first))
              if all(tables[base][index] == first[index] for base in bases[1:])]
    state_to_table = None
    selector_end = STATE_TABLE_BASE + STATE_TABLE_COUNT * 4
    if selector_end <= len(region) and all(occupied[STATE_TABLE_BASE:selector_end]):
        state_to_table = [
            {"state": state, "rom_base": f"0x{int.from_bytes(region[offset:offset + 4], 'big'):05X}"}
            for state, offset in enumerate(
                range(STATE_TABLE_BASE, selector_end, 4))
        ]
    result = {
        "schema": "stunrun-track-table-analysis/v1",
        "manifest": str(args.manifest),
        "rompath": str(args.rompath),
        "table_word_count": TABLE_BYTES // 2,
        "table_bases": [f"0x{base:05X}" for base in bases],
        "slots": {
            f"0x{base:05X}": {
                "sha256": hashlib.sha256(bytes(region[base:base + TABLE_BYTES])).hexdigest(),
                "block_sha256_48_words": [
                    hashlib.sha256(bytes(region[base + offset:base + offset + 0x60])).hexdigest()
                    for offset in range(0, TABLE_BYTES, 0x60)
                ],
            }
            for base in bases
        },
        "common_word_ranges": contiguous_ranges(common),
        "common_word_count": len(common),
        "variable_word_ranges": contiguous_ranges(
            [index for index in range(len(first)) if index not in set(common)]),
        "state_table_selector": {
            "rom_base": f"0x{STATE_TABLE_BASE:05X}",
            "entry_count": STATE_TABLE_COUNT,
            "state_to_table": state_to_table,
        },
        "common_tail_sha256": (
            hashlib.sha256(table_payloads[bases[0]][0x2D0:0x300]).hexdigest()
            if all(table_payloads[base][0x2D0:0x300] ==
                   table_payloads[bases[0]][0x2D0:0x300] for base in bases[1:])
            else None),
    }
    if args.snapshot:
        comparisons = []
        for snapshot_path in args.snapshot:
            snapshot = json.loads(snapshot_path.read_text(encoding="utf-8"))
            if snapshot.get("schema") != "stunrun-memory-snapshot/v1":
                raise SystemExit(f"{snapshot_path}: expected stunrun-memory-snapshot/v1")
            snapshot_base = snapshot.get("base")
            if not isinstance(snapshot_base, int) or snapshot.get("width") != 8:
                raise SystemExit(f"{snapshot_path}: expected an 8-bit snapshot containing 0x{RAM_BASE:X}")
            values = snapshot.get("values")
            offset = RAM_BASE - snapshot_base
            if offset < 0 or not isinstance(values, list) or len(values) < offset + TABLE_BYTES * 2:
                raise SystemExit(f"{snapshot_path}: snapshot must include base and twin buffers")
            buffer_bytes = bytes(values[offset:offset + TABLE_BYTES])
            twin_bytes = bytes(values[offset + TABLE_BYTES:offset + TABLE_BYTES * 2])
            matches = []
            for base in bases:
                table = table_payloads[base]
                different = [index for index in range(TABLE_BYTES // 2)
                             if buffer_bytes[index * 2:index * 2 + 2] !=
                             table[index * 2:index * 2 + 2]]
                matches.append({
                    "slot": f"0x{base:05X}",
                    "different_word_count": len(different),
                    "different_word_ranges": contiguous_ranges(different),
                    "exact_word_ranges": contiguous_ranges(
                        [index for index in range(TABLE_BYTES // 2)
                         if index not in set(different)]),
                })
            matches.sort(key=lambda item: (item["different_word_count"], item["slot"]))
            comparisons.append({
                "path": str(snapshot_path),
                "frame": snapshot.get("frame"),
                "buffer_sha256": hashlib.sha256(buffer_bytes).hexdigest(),
                "settled_tail_sha256": hashlib.sha256(
                    buffer_bytes[0x2D0:0x300]).hexdigest(),
                "twin_different_byte_count": sum(
                    left != right for left, right in zip(buffer_bytes, twin_bytes)),
                "best": matches[0],
                "matches": matches,
            })
        result["snapshot_comparisons"] = comparisons
    encoded = json.dumps(result, indent=2) + "\n"
    if args.output:
        args.output.write_text(encoded, encoding="utf-8")
    else:
        print(encoded, end="")


if __name__ == "__main__":
    raise SystemExit(main())
