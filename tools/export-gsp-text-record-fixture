#!/usr/bin/env python3
"""Export complete GSP text records from a register/write trace result."""

import argparse
import json
import pathlib
import struct


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("trace", type=pathlib.Path,
                        help="stunrun-ram-write-trace result JSON")
    parser.add_argument("--frame", type=int, required=True)
    parser.add_argument("--record-base", action="append", required=True,
                        help="record base address (repeat in output order)")
    parser.add_argument("--output", type=pathlib.Path, required=True)
    args = parser.parse_args()
    source = json.loads(args.trace.read_text(encoding="utf-8"))
    if source.get("schema") != "stunrun-ram-write-trace-result/v1":
        raise SystemExit(f"{args.trace}: expected a RAM write trace result")
    events = source.get("events")
    if not isinstance(events, list):
        raise SystemExit(f"{args.trace}: missing events list")
    selected = {}
    for event in events:
        if event.get("frame") != args.frame:
            continue
        selected[(event.get("address"), event.get("pc"))] = event
    words = []
    records = []
    for base_text in args.record_base:
        base = int(base_text, 0)
        record_words = []
        writer_pcs = []
        for index in range(8):
            address = base + index * 0x10
            matches = [event for (event_address, _), event in selected.items()
                       if event_address == address]
            if not matches:
                raise SystemExit(f"{args.trace}: missing frame {args.frame} word at 0x{address:X}")
            event = matches[-1]
            record_words.append(event["data"] & 0xffff)
            writer_pcs.append(event.get("pc"))
        words.extend(record_words)
        records.append({"base": f"0x{base:X}",
                        "words": [f"0x{word:04X}" for word in record_words],
                        "writer_pcs": sorted({f"0x{pc:X}" for pc in writer_pcs
                                               if pc is not None})})
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_bytes(b"".join(struct.pack("<H", word) for word in words))
    print(json.dumps({"schema": "stunrun-gsp-text-record-fixture/v1",
                      "frame": args.frame, "record_count": len(records),
                      "word_count": len(words), "records": records,
                      "output": str(args.output)}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
