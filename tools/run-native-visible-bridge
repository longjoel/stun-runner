#!/usr/bin/env python3
"""Run the native captured-GSP bridge and compare its visible frame."""

import argparse
import json
import os
import pathlib
import subprocess
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]
COMPARE = ROOT / "tools" / "compare-ppm"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("native", type=pathlib.Path,
                        help="native shell executable")
    parser.add_argument("vram", type=pathlib.Path)
    parser.add_argument("palette", type=pathlib.Path)
    parser.add_argument("expected", type=pathlib.Path,
                        help="expected P6 PPM frame")
    parser.add_argument("--actual", type=pathlib.Path, required=True,
                        help="output P6 PPM path")
    args = parser.parse_args()
    for path in (args.native, args.vram, args.palette, args.expected):
        if not path.is_file():
            raise SystemExit(f"missing bridge input: {path}")
    environment = {
        **os.environ,
        "STUNRUN_GSP_VRAM_BIN": str(args.vram),
        "STUNRUN_GSP_PALETTE_BIN": str(args.palette),
        "STUNRUN_RENDER_PPM": str(args.actual),
    }
    native_run = subprocess.run([str(args.native)], env=environment,
                                 capture_output=True, text=True, check=False)
    comparison = None
    compare_returncode = None
    if native_run.returncode == 0 and args.actual.is_file():
        compare = subprocess.run([str(COMPARE), str(args.expected),
                                  str(args.actual)],
                                 capture_output=True, text=True, check=False)
        compare_returncode = compare.returncode
        try:
            comparison = json.loads(compare.stdout)
        except json.JSONDecodeError:
            comparison = {"error": "compare-ppm did not emit JSON",
                          "stdout": compare.stdout,
                          "stderr": compare.stderr}
    result = {
        "schema": "stunrun-native-visible-bridge-result/v1",
        "native": str(args.native),
        "vram": str(args.vram),
        "palette": str(args.palette),
        "expected": str(args.expected),
        "actual": str(args.actual),
        "native_returncode": native_run.returncode,
        "compare_returncode": compare_returncode,
        "comparison": comparison,
    }
    print(json.dumps(result, sort_keys=True))
    return 0 if native_run.returncode == 0 and compare_returncode == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
