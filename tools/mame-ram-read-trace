#!/usr/bin/env python3
"""Trace reads from a selected MAME memory-space window."""

import argparse
import collections
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import tempfile


EVENT = re.compile(
    r"M1_RAM_READ frame=(\d+) pc=([0-9A-Fa-f]+) addr=([0-9A-Fa-f]+) "
    r"data=([0-9A-Fa-f]+) mask=([0-9A-Fa-f]+)"
)
DONE = re.compile(r"M1_RAM_READ_DONE frames=(\d+) events=(\d+) truncated=(true|false)")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--device", default=":mainpcb:maincpu")
    parser.add_argument("--space", default="program")
    parser.add_argument("--base", type=lambda value: int(value, 0), required=True)
    parser.add_argument("--end", type=lambda value: int(value, 0), required=True)
    parser.add_argument("--frames", type=int, default=1800)
    parser.add_argument("--start-frame", type=int, default=600)
    parser.add_argument("--end-frame", type=int, default=1800)
    parser.add_argument("--max-events", type=int, default=100000)
    parser.add_argument("--pc", type=lambda value: int(value, 0),
                        help="capture reads only while the CPU PC equals this value")
    parser.add_argument("--input", choices=("none", "late_drive", "weapon_probe", "course_sweep", "course_coin2", "service_probe", "sw1_all_on", "fork_hold_left", "fork_center"), default="none")
    parser.add_argument("--load-state", type=pathlib.Path)
    parser.add_argument("--playback", type=pathlib.Path,
                        help="replay a recorded .inp with no scripted inputs")
    parser.add_argument("--nothrottle", action="store_true")
    parser.add_argument("--mame", default="mame")
    args = parser.parse_args()
    if not (0 <= args.base <= args.end and 0 <= args.start_frame <= args.end_frame <= args.frames):
        parser.error("invalid address or frame range")
    if args.load_state and not args.load_state.is_file():
        raise SystemExit(f"save state does not exist: {args.load_state}")
    if args.load_state and args.playback:
        parser.error("--load-state and --playback are mutually exclusive")
    playback = None
    if args.playback:
        playback = args.playback.resolve()
        if not playback.is_file():
            raise SystemExit(f"missing input recording: {args.playback}")
        if args.input != "none":
            parser.error("--playback requires --input none")
    args.output.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    state_stage = None
    state_directory = "/tmp/stunrun-state-dir"
    if args.load_state:
        state_stage = pathlib.Path(tempfile.mkdtemp(prefix="stunrun-ram-read-"))
        slot_directory = state_stage / "stunrun"
        slot_directory.mkdir()
        shutil.copy2(args.load_state, slot_directory / "1.sta")
        state_directory = str(state_stage)
    command = [
        args.mame, "-rompath", str(args.rompath), "stunrun", "-video", "none",
        "-sound", "none", "-skip_gameinfo", "-noreadconfig", "-nowriteconfig",
        "-cfg_directory", "/tmp/stunrun-mame-cfg", "-nonvram_save",
        "-state_directory", state_directory, "-statename", "%g",
        "-seconds_to_run", str(86400 if args.load_state else max(2, (args.frames + 59) // 60 + 1)),
        "-autoboot_script",
        str(pathlib.Path(__file__).resolve().parents[1] / "mame/lua/ram-read-trace.lua"),
    ]
    if args.load_state:
        command += ["-state", "1"]
    if playback is not None:
        for flag in ("-noreadconfig", "-nowriteconfig",
                     "-cfg_directory", "/tmp/stunrun-mame-cfg",
                     "-nonvram_save"):
            command.remove(flag)
        command += ["-input_directory", str(playback.parent),
                    "-playback", playback.name]
    if args.nothrottle:
        command.insert(command.index("-seconds_to_run"), "-nothrottle")
    environment = {
        **os.environ,
        "STUNRUN_RAM_READ_OUT": str(args.output),
        "STUNRUN_RAM_READ_FRAMES": str(args.frames),
        "STUNRUN_RAM_READ_START": str(args.start_frame),
        "STUNRUN_RAM_READ_END": str(args.end_frame),
        "STUNRUN_RAM_READ_INPUT": args.input,
        "STUNRUN_RAM_READ_DEVICE": args.device,
        "STUNRUN_RAM_READ_SPACE": args.space,
        "STUNRUN_RAM_READ_BASE": str(args.base),
        "STUNRUN_RAM_READ_END_ADDRESS": str(args.end),
        "STUNRUN_RAM_READ_MAX_EVENTS": str(args.max_events),
        "STUNRUN_RAM_READ_PC": str(args.pc) if args.pc is not None else "",
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "dummy"),
    }
    try:
        with log.open("w", encoding="utf-8") as handle:
            completed = subprocess.run(command, stdout=handle, stderr=subprocess.STDOUT,
                                       env=environment, check=False)
        text = log.read_text(encoding="utf-8")
    finally:
        if state_stage is not None:
            shutil.rmtree(state_stage, ignore_errors=True)
    events = [{"frame": int(m.group(1)), "pc": int(m.group(2), 16),
               "address": int(m.group(3), 16), "data": int(m.group(4), 16),
               "mask": int(m.group(5), 16)} for m in EVENT.finditer(text)]
    done = DONE.findall(text)
    result = {
        "schema": "stunrun-ram-read-trace-result/v1",
        "device": args.device, "space": args.space, "base": args.base, "end": args.end,
        "load_state": str(args.load_state) if args.load_state else None,
        "frames": args.frames, "capture_start_frame": args.start_frame,
        "capture_end_frame": args.end_frame, "input": args.input,
        "playback": str(playback) if playback else None,
        "pc": args.pc,
        "returncode": completed.returncode, "events": events, "event_count": len(events),
        "reader_pcs": sorted({event["pc"] for event in events}),
        "pc_counts": {f"0x{pc:X}": count for pc, count in
                       collections.Counter(event["pc"] for event in events).items()},
        "canonical_log_sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
    }
    if done:
        result["truncated"] = done[-1][2] == "true"
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    if completed.returncode or not done:
        raise SystemExit(f"RAM read trace failed; see {log}")
    print(json.dumps({key: value for key, value in result.items() if key != "events"}, separators=(",", ":")))


if __name__ == "__main__":
    raise SystemExit(main())
