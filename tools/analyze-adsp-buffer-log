#!/usr/bin/env python3
"""Summarize the 68010 ADSP-buffer block/terminator protocol from a tap log."""

import argparse
import collections
import json
import pathlib
import re


READ = re.compile(
    r"M1_ADSP_READ kind=buffer pc=([0-9A-Fa-f]+) addr=([0-9A-Fa-f]+) "
    r"data=([0-9A-Fa-f]+) mask=([0-9A-Fa-f]+)"
)
BLOCK = re.compile(
    r"M1_ADSP_BLOCK frame=(\d+) sequence=(\d+) count=(\d+) "
    r"terminator=([0-9A-Fa-f]+) fifo_writes=(\d+)"
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("log", type=pathlib.Path)
    args = parser.parse_args()

    headers = []
    terminators = []
    block_summaries = []
    for line in args.log.read_text(encoding="utf-8").splitlines():
        block = BLOCK.search(line)
        if block:
            block_summaries.append({
                "frame": int(block.group(1)), "sequence": int(block.group(2)),
                "count": int(block.group(3)), "terminator": int(block.group(4), 16),
                "fifo_writes": int(block.group(5)),
            })
            continue
        match = READ.search(line)
        if not match:
            continue
        pc, address, data, mask = (int(match.group(i), 16) for i in range(1, 5))
        if pc == 0x02F0C2:
            headers.append({"address": address, "count": data, "mask": mask})
        elif pc == 0x02F0E2:
            terminators.append({"address": address, "data": data, "mask": mask})

    pairs = []
    for header, terminator in zip(headers, terminators):
        pairs.append({
            "count": header["count"],
            "header_address": header["address"],
            "terminator_address": terminator["address"],
            "terminator_data": terminator["data"],
            "address_formula": terminator["address"] == header["address"] + header["count"] * 2,
        })
    result = {
        "schema": "stunrun-adsp-buffer-analysis/v1",
        "header_reads": len(headers),
        "terminator_reads": len(terminators),
        "paired_blocks": len(pairs),
        "count_histogram": dict(sorted(collections.Counter(p["count"] for p in pairs).items())),
        "all_terminators_ff": all(p["terminator_data"] == 0xFFFF for p in pairs),
        "all_address_formulas_match": all(p["address_formula"] for p in pairs),
        "block_summaries": len(block_summaries),
        "all_fifo_write_counts_match": bool(block_summaries)
        and all(block["count"] == block["fifo_writes"] for block in block_summaries),
        "first_block_summaries": block_summaries[:16],
        "last_block_summaries": block_summaries[-16:],
        "first_blocks": pairs[:16],
        "last_blocks": pairs[-16:],
    }
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
