#!/usr/bin/env python3
"""Summarize frame- and PC-attributed GSP VRAM write-trace results."""

import argparse
import collections
import json
import pathlib


def load(path: pathlib.Path) -> dict:
    value = json.loads(path.read_text(encoding="utf-8"))
    if value.get("schema") != "stunrun-ram-write-trace-result/v1":
        raise SystemExit(f"{path}: unsupported RAM write-trace schema")
    return value


def ranges(values: set[int]) -> list[dict[str, int]]:
    if not values:
        return []
    ordered = sorted(values)
    result = []
    start = previous = ordered[0]
    for value in ordered[1:]:
        if value != previous + 1:
            result.append({"start": start, "end": previous,
                           "count": previous - start + 1})
            start = value
        previous = value
    result.append({"start": start, "end": previous,
                   "count": previous - start + 1})
    return result


def parse_labels(values: list[str]) -> dict[int, str]:
    labels = {}
    for value in values:
        try:
            pc_text, label = value.split("=", 1)
            labels[int(pc_text, 0)] = label
        except ValueError as error:
            raise SystemExit(f"invalid --label {value!r}; expected PC=TEXT") from error
    return labels


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("trace", type=pathlib.Path)
    parser.add_argument("-o", "--output", type=pathlib.Path)
    parser.add_argument("--label", action="append", default=[],
                        help="label a writer PC, e.g. 0xFFF46590=PIXBLT")
    args = parser.parse_args()
    trace = load(args.trace)
    labels = parse_labels(args.label)
    by_pc = collections.defaultdict(list)
    for event in trace.get("events", []):
        by_pc[event["pc"]].append(event)

    writers = {}
    for pc, events in sorted(by_pc.items()):
        by_frame = collections.Counter(event["frame"] for event in events)
        addresses = {event["address"] for event in events}
        writers[f"0x{pc:X}"] = {
            "pc": pc,
            "label": labels.get(pc),
            "event_count": len(events),
            "frames": sorted(by_frame),
            "frame_counts": {str(frame): count
                             for frame, count in sorted(by_frame.items())},
            "unique_address_count": len(addresses),
            "address_min": min(addresses),
            "address_max": max(addresses),
            "address_ranges": ranges(addresses),
        }
    result = {
        "schema": "stunrun-gsp-vram-write-summary/v1",
        "trace": str(args.trace),
        "device": trace.get("device"),
        "space": trace.get("space"),
        "base": trace.get("base"),
        "end": trace.get("end"),
        "capture_start_frame": trace.get("capture_start_frame"),
        "capture_end_frame": trace.get("capture_end_frame"),
        "event_count": len(trace.get("events", [])),
        "truncated": trace.get("truncated", False),
        "writers": writers,
    }
    encoded = json.dumps(result, indent=2) + "\n"
    if args.output:
        args.output.write_text(encoded, encoding="utf-8")
    else:
        print(encoded, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
